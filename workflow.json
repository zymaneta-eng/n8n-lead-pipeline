      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_DEVOPS_CHAT_ID || '-100987654321' }}",
        "text": "=🚨 *Критичний збій у пайплайні лідогенерації n8n!*\n\n*Workflow:* {{ $workflow.name }}\n*Execution ID:* `{{ $execution.id }}`\n*Нода помилки:* `{{ $execution.error.node.name }}`\n*Повідомлення:* `{{ $execution.error.message }}`\n\n⏰ *Час:* {{ new Date().toISOString() }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "1a3b5c7d-0015-4000-8000-000000000015",
      "name": "Telegram: Alert DevOps DLQ",
